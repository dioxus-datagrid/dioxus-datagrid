{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component",
  "description": "A component compatible with the dioxus components system.\nThis may be a \"virtual\" component which is empty except for a list of members.",
  "type": "object",
  "properties": {
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cargoDependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CargoDependency"
      }
    },
    "componentDependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComponentDependency"
      }
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "globalAssets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "$defs": {
    "CargoDependency": {
      "description": "A dependency on a cargo crate required for a component.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "default_features": {
              "type": "boolean"
            },
            "features": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "git": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "rev": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            }
          },
          "required": [
            "name"
          ]
        }
      ]
    },
    "ComponentDependency": {
      "description": "A dependency on another component, either built-in or third-party.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "git": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "rev": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            }
          },
          "required": [
            "name",
            "git"
          ]
        }
      ]
    }
  }
}
